{
  "name": "beacon-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Beacon - Electron frontend for py-beacon",
  "author": "karanbh01",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "predev": "node scripts/build-tokens.mjs && node scripts/build-icons.mjs",
    "prebuild": "node scripts/build-tokens.mjs && node scripts/build-icons.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs && git diff --exit-code -- src/renderer/src/tokens",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:dry": "electron-builder --dir --publish never",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs && git diff --exit-code -- src/renderer/src/icons/generated.tsx src/renderer/src/icons/registry.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "spec:refresh": "node scripts/refresh-spec.mjs && pnpm run api:build",
    "api:build": "openapi-typescript openapi.json -o src/shared/api.generated.ts",
    "api:check": "openapi-typescript openapi.json -o src/shared/api.generated.ts && git diff --exit-code -- src/shared/api.generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3",
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "electron-updater": "^6.3.9",
    "lightweight-charts": "^5.2.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-essentials": "^8",
    "@storybook/addon-themes": "^8",
    "@storybook/react": "^8",
    "@storybook/react-vite": "^8",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2",
    "electron": "^33.3.1",
    "electron-builder": "^25",
    "electron-vite": "^2.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8",
    "vite": "^5.4.11",
    "vitest": "^2"
  }
}
